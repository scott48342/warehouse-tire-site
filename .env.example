# WTD Environment Variables Example
# Copy to .env.local and fill in real values

# ============================================================================
# Database
# ============================================================================
POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ============================================================================
# Authentication (Better Auth)
# ============================================================================
# Required: 32+ character random secret for signing auth tokens
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here-min-32-characters"

# Optional: Custom base URL (auto-detected from VERCEL_URL in production)
# NEXT_PUBLIC_BASE_URL="https://shop.warehousetiredirect.com"

# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# Optional: Custom from address for auth emails
# AUTH_EMAIL_FROM="Warehouse Tire Direct <noreply@warehousetiredirect.com>"

# ============================================================================
# Other Services
# ============================================================================
# ... (existing env vars)

# Capital Tire / TireWorks HD dealer inventory (server only; local storefront)
# Use the direct east.tireworkshd.com Service.asmx account values, not the email safety redirect URL.
# Never prefix these with NEXT_PUBLIC_. No order placement uses this connection.
# CAPITAL_TIRE_APPLICATION_UID=""
# CAPITAL_TIRE_COMPANY_ID=""
# CAPITAL_TIRE_LOCATION_ID=""
# CAPITAL_TIRE_CUSTOMER_ID=""
# CAPITAL_TIRE_ADDRESS_ID=""
