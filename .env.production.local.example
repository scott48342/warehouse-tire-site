# .env.production.local.example
# ---------------------------------------------------------------------------
# Template for LOCAL production-mode runs (`next build && next start`).
#
# Next.js loads env files in this priority for `next start` (NODE_ENV=production):
#   .env.production.local  >  .env.local  >  .env.production  >  .env
#
# IMPORTANT: Do NOT keep a real `.env.production.local` that overrides
# POSTGRES_URL with a different database than Vercel production. Doing so makes
# local `next start` hit the wrong DB and produces FALSE failures (e.g. a
# missing `tireweb_sku_cache` table causes bare TireWeb PDP URLs to 404 locally
# even though they work in production).
#
# RULE: local production-mode testing must use the SAME database family as
# Vercel production. Vercel production POSTGRES_URL points at the Neon Postgres
# instance (host: ep-aged-dust-*.neon.tech). The committed app secrets for local
# dev already live in `.env.local`, which uses the correct Neon POSTGRES_URL.
#
# RECOMMENDED: do NOT create a real `.env.production.local` at all. With it
# absent, `next start` falls back to `.env.local` (Neon) and matches Vercel.
#
# If you DO need a `.env.production.local` (e.g. to set production-only flags),
# only override the keys you actually need and leave POSTGRES_URL pointed at the
# same Neon instance as Vercel. NEVER point it at db.prisma.io / the Prisma proxy
# endpoint, which does not contain all runtime tables (e.g. tireweb_sku_cache).
#
# To regenerate real production values from Vercel (writes a gitignored file):
#   npx vercel env pull .env.production.local --environment=production
# After pulling, VERIFY the POSTGRES_URL host is the Neon instance, not prisma.io.
# ---------------------------------------------------------------------------

# Postgres (MUST match Vercel production = Neon). Placeholder only:
POSTGRES_URL="postgresql://USER:PASSWORD@ep-aged-dust-XXXX-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Public base URL used by server-side fetches during prod-mode runs:
NEXT_PUBLIC_BASE_URL="https://shop.warehousetiredirect.com"
