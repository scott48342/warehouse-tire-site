      "description": "Quarantine records missing bolt_pattern or center_bore_mm",
      "queries": [
        {
          "description": "Mark records with missing wheel fields",
          "sql": "UPDATE vehicle_fitments \nSET quality_tier = 'quarantined', \n    quarantined_at = NOW(),\n    last_modified_reason = 'Missing bolt_pattern or center_bore_mm - needs backfill'\nWHERE (bolt_pattern IS NULL OR center_bore_mm IS NULL)\n  AND quality_tier != 'quarantined';",
